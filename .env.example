# ══════════════════════════════════════════════════════════════
#  OCEAN QUEST • Variables d'environnement (à copier dans Render)
#  Render > ton service > Environment > « Add from .env »
#  ⚠️ Copie ce fichier en .env et remplis les valeurs
# ══════════════════════════════════════════════════════════════

# ─── Discord ───
DISCORD_GUILD_ID=1549380623117058061

# Bot 1 • Ocean Ticket (application 1549384157216378882)
TICKET_BOT_TOKEN=ton_token_du_bot_ocean_ticket
TICKET_BOT_NAME=Ocean Ticket

# Bot 2 • Ocean Guard (sécurité : vérification, anti-raid, automod, logs, modération)
# Tant que le token est vide, Ocean Ticket s'occupe de la sécurité.
SECURITY_BOT_TOKEN=
SECURITY_BOT_NAME=Ocean Guard

# Bot 3 • Ocean Quest (tout le reste : bienvenue, rôles, niveaux, pêche, giveaways…)
# Tant que le token est vide, Ocean Ticket s'occupe de ces modules.
MAIN_BOT_TOKEN=
MAIN_BOT_NAME=Ocean Quest

# Renomme automatiquement chaque bot avec le nom ci-dessus
SYNC_BOT_NAMES=true
# Publie / met à jour les panneaux (tickets, vérif, rôles, règlement) au démarrage
AUTO_PANELS=true
# Reconstruit le serveur à chaque démarrage (laisse false, utilise /setup)
SETUP_ON_START=false

# ─── Supabase ───
SUPABASE_URL=https://pwuwcactpmzmguclthvj.supabase.co
# Clé publishable fournie. Recommandé : remplace-la par la clé secrète (sb_secret_…)
SUPABASE_KEY=sb_publishable_ou_sb_secret_xxx

# ─── Render ───
PUBLIC_URL=https://oceanquest.onrender.com
# Ping /health toutes les 10 min pour éviter la mise en veille du plan gratuit
KEEP_ALIVE=true
NODE_VERSION=22
TZ=Europe/Paris

# ─── Jeu Roblox ───
GAME_NAME=Ocean Quest
# Colle ici le lien de ton jeu et de ton groupe Roblox (boutons dans #liens-utiles et /jouer)
ROBLOX_GAME_URL=
ROBLOX_GROUP_URL=

# ─── Tickets ───
TICKET_MAX_OPEN=2
TICKET_DELETE_DELAY_SEC=5

# ─── Sécurité ───
MIN_ACCOUNT_AGE_DAYS=3
RAID_JOIN_THRESHOLD=8
RAID_JOIN_WINDOW_SEC=20
RAID_DURATION_MIN=10
SPAM_MESSAGE_LIMIT=6
SPAM_WINDOW_SEC=5
SPAM_TIMEOUT_MIN=10
MAX_MENTIONS=5
BLOCK_INVITES=true
BLOCK_SCAM_LINKS=true
ANTINUKE_THRESHOLD=3
ANTINUKE_WINDOW_SEC=60
# IDs Discord (séparés par des virgules) jamais visés par l'anti-nuke
SECURITY_WHITELIST=

# ─── Niveaux & pêche ───
XP_MIN=15
XP_MAX=25
XP_COOLDOWN_SEC=60
FISHING_COOLDOWN_SEC=30
